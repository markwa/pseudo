count = 0
for i=0 to 2
  print("Loop " + str(i))
next i

answer = ""
while answer != "computer"
  answer = input("Password? ")
endwhile

do
  answer = input("Type computer to stop: ")
until answer == "computer"

switch answer:
  case "computer":
    print("Unlocked")
  default:
    print("Nope")
endswitch
